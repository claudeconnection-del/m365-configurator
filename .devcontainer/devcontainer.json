{
  // Reproducible development environment for m365-configurator.
  // Ships PowerShell 7.6 and, on create, installs the required M365 modules AND
  // the dev/test tooling (Pester), so a fresh `git clone` + "Reopen in Container"
  // is enough to develop and to run `Invoke-Pester -Path tests/`.
  "name": "m365-configurator",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    // Pinned to 7.6 — the ADR-0015 floor AND target (amended 2026-07-25: the
    // pinned ExchangeOnlineManagement 3.10.0 requires 7.6+/.NET 10, so there is
    // no lower floor to develop against). The SHIPPED container (MCA-9, Phase 5)
    // will pin the same 7.6.x/.NET 10 pair.
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "7.6"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Trust the bind-mounted workspace first: the workspace folder's owning UID
  // commonly differs from the 'vscode' user's (a bind-mount/Docker Desktop
  // quirk, not something particular to this repo), which trips git's "dubious
  // ownership" safety check (CVE-2022-24765) and makes every git command in a
  // fresh container fail until a human runs this by hand and re-pulls. Doing
  // it here means "Reopen in Container" -> open a terminal -> git works, no
  // detour required (observed live, 2026-07-26).
  //
  // Then install the M365 PowerShell modules and dev/test tooling, and wire up
  // the dev shell profile so a fresh terminal auto-imports the module and
  // hints at Connect-M365 — "reopen in container, open a terminal,
  // authenticate" should be the whole onboarding path. Runs as the non-root
  // 'vscode' user; installs into CurrentUser scope, no elevation.
  "postCreateCommand": "git config --global --add safe.directory ${containerWorkspaceFolder} && pwsh -NoProfile -File scripts/install-modules.ps1 && pwsh -NoProfile -File scripts/install-dev-tools.ps1 && pwsh -NoProfile -File scripts/setup-devshell-profile.ps1",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "powershell.powerShellDefaultVersion": "PowerShell (7)",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "vscode"
}
