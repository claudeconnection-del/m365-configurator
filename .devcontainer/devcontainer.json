{
  // Reproducible development environment for m365-configurator.
  // Ships PowerShell 7.6 and, on create, installs the required M365 modules AND
  // the dev/test tooling (Pester), so a fresh `git clone` + "Reopen in Container"
  // is enough to develop and to run `Invoke-Pester -Path tests/`.
  "name": "m365-configurator",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    // Pinned to 7.6 — the ADR-0015 floor AND target (amended 2026-07-25: the
    // pinned ExchangeOnlineManagement 3.10.0 requires 7.6+/.NET 10, so there is
    // no lower floor to develop against). The SHIPPED container (MCA-9, Phase 5)
    // will pin the same 7.6.x/.NET 10 pair.
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "7.6"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Install the M365 PowerShell modules and dev/test tooling once the container
  // is built, then wire up the dev shell profile so a fresh terminal auto-imports
  // the module and hints at Connect-M365 — "reopen in container, open a terminal,
  // authenticate" should be the whole onboarding path. Runs as the non-root
  // 'vscode' user; installs into CurrentUser scope, no elevation.
  "postCreateCommand": "pwsh -NoProfile -File scripts/install-modules.ps1 && pwsh -NoProfile -File scripts/install-dev-tools.ps1 && pwsh -NoProfile -File scripts/setup-devshell-profile.ps1",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "powershell.powerShellDefaultVersion": "PowerShell (7)",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "vscode"
}
