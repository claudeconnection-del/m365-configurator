{
  // Reproducible development environment for m365-configurator.
  // Ships PowerShell 7 and, on create, installs the required M365 modules AND the
  // dev/test tooling (Pester), so a fresh `git clone` + "Reopen in Container" is
  // enough to develop and to run `Invoke-Pester -Path tests/`.
  "name": "m365-configurator",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    // Pinned to the PowerShell 7.4 LTS line for stability (see design tenet #6).
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "7.4"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Install the M365 PowerShell modules and dev/test tooling once the container
  // is built. Runs as the non-root 'vscode' user; installs into CurrentUser scope.
  "postCreateCommand": "pwsh -NoProfile -File scripts/install-modules.ps1 && pwsh -NoProfile -File scripts/install-dev-tools.ps1",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "powershell.powerShellDefaultVersion": "PowerShell (7)",
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "vscode"
}
